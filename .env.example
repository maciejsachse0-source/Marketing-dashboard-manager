# Postgres connection string (Neon, Vercel Postgres, Supabase, …)
# Use the *pooled* / pgbouncer URL — driver below disables prepared statements
# so it stays compatible with transaction-mode poolers.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Perf measurement database. The L data set (scripts/perf/seed-large.ts) lives
# here and ONLY here — the generator refuses to run when this equals
# DATABASE_URL, so the working database never gets 500 synthetic productions.
PERF_DATABASE_URL=postgres://user:password@host/db_perf?sslmode=require

# Test database. Integration tests truncate it between runs, so it must never
# point at the working or the perf database.
TEST_DATABASE_URL=postgres://user:password@host/db_test?sslmode=require

# Postgres pool size for the app (src/lib/db.ts). Serverless wants 1, a long
# lived local dev server benefits from more. Unset = driver default.
DB_POOL_MAX=

# Vercel Blob — required for file uploads (briefs, CSV, outreach, assets).
# Locally optional; without it, file-uploading routes fall back to disk in
# .data-local-blob/ for dev convenience.
BLOB_READ_WRITE_TOKEN=

# Auth — single-user demo login. Override in production.
AUTH_EMAIL=admin@demo.pl
AUTH_PASSWORD=demo
# Used to sign session cookies. REQUIRED — must be ≥32 chars.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
