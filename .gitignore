# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local data — sqlite + user files
# Pozostalosci po wersji na SQLite. Silnika juz nie ma, wpisy zostaja jako
# bezpiecznik: gdyby ktos odpalil stary skrypt, plik bazy nie wjedzie do repo.
/data/*.db
/data/*.db-shm
/data/*.db-wal

# Katalog roboczy importu osob z arkusza (plan/04). Dane osobowe, nie do repo.
.data-import/
/data/files/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# playwright
/test-results/
/playwright-report/
/blob-report/

# perf: wyniki przebiegow sa lokalne, baseline i budzet ida do repo
/perf/runs/

# import: arkusze poza gitem (zasada Z14). Fixture jest generowany deterministycznie
# przez `npx tsx scripts/make-fixture-xlsx.ts`, wiec nie ma powodu trzymac go w repo.
/tests/fixtures/*.xlsx
/.data-import/
